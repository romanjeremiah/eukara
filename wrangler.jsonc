{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-ai-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-14",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"limits": {
		"cpu_ms": 300000
	},
	"kv_namespaces": [
		{
			"binding": "CHAT_KV",
			"id": "85aaf33b263a4b92a18fde3ba9578689"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-db",
			"database_id": "c4fca0f2-7883-429f-9902-3831ea104bcb"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "my-ai-bot-media"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "my-ai-bot-memory"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"queues": {
		"producers": [
			{
				"queue": "my-ai-bot-tasks",
				"binding": "TASK_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "my-ai-bot-tasks",
				"max_batch_size": 1,
				"max_batch_timeout": 5
			}
		]
	},
	"triggers": {
		"crons": [
			"* * * * *"
		]
	}
}
